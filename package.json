{
	"name": "shoot",
	"version": "1.0.0",
	"description": "Activitypub federated instant messaging server",
	"license": "AGPL-3.0-or-later",
	"author": "MaddyUnderStars",
	"type": "module",
	"main": "dist/src/bootstrap.js",
	"scripts": {
		"start": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/bootstrap.js",
		"start:http": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/http/bootstrap.js",
		"start:gateway": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/gateway/bootstrap.js",
		"start:media": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/media/bootstrap.js",
		"start:push": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/push/worker.js",
		"start:inbound_queue": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/receiver/index.js",
		"cli": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/cli/index.js",
		"build": "tsc",
		"tailwind": "npx @tailwindcss/cli -i assets/public/index.css -o assets/public/output.css --watch",
		"prepare": "husky || true",
		"openapi": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/scripts/openapi.js",
		"config": "node --enable-source-maps --import ./dist/src/zodOpenapi.js dist/src/scripts/configSchema.js",
		"test": "vitest",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@aws-sdk/client-s3": "^3.1124.0",
		"@aws-sdk/s3-request-presigner": "^3.1124.0",
		"@node-oauth/express-oauth-server": "^4.2.0",
		"@node-oauth/oauth2-server": "^5.3.0",
		"@shootpub/activitypub-types": "^3.1.5",
		"bcrypt": "^6.0.0",
		"body-parser": "^2.3.0",
		"bufferutil": "^4.1.0",
		"bullmq": "^6.3.4",
		"config": "^5.0.1",
		"cors": "^2.8.5",
		"domutils": "^4.0.2",
		"express": "^4.21.2",
		"express-handlebars": "^9.0.1",
		"express-rate-limit": "^7.5.0",
		"handlebars": "^4.7.9",
		"htmlparser2": "^12.0.0",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.12.0",
		"patch-package": "^8.0.1",
		"rabbitmq-stream-js-client": "^1.1.0",
		"ts-deepmerge": "^8.0.0",
		"typeorm": "^1.1.1",
		"uuid": "^14.0.2",
		"web-push": "^3.6.7",
		"ws": "^8.21.3",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@swc/core": "^1.16.1",
		"@tailwindcss/cli": "^4.3.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/bcrypt": "^6.0.0",
		"@types/config": "^3.3.3",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/morgan": "^1.9.9",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"@types/sinon": "^22.0.0",
		"@types/supertest": "^7.2.1",
		"@types/web-push": "^3.6.4",
		"@types/ws": "^8.5.13",
		"@vitest/coverage-v8": "^4.1.11",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"pg": "^8.23.0",
		"supertest": "^7.2.2",
		"tailwindcss": "^4.3.3",
		"testcontainers": "^12.1.0",
		"typescript": "^6.0.2",
		"unplugin-swc": "^1.5.11",
		"vitest": "^4.1.11"
	},
	"lint-staged": {
		"*.{ts,js,md,tsx,jsx,css}": "oxlint --no-error-on-unmatched-pattern",
		"*": "oxfmt --no-error-on-unmatched-pattern"
	}
}
